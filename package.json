{
    "name": "earsmixer",
    "main": "index.js",
    "engines": { "node": ">=22.13.0" },
    "version": "2.6.0",
    "description": "A server that allows web clients and other external devices to control their own mix for DiGiCo sound desks.",
    "author": "Marc Castles",
    "homepage": "https://github.com/joeclack/EarsMixer",
    "repository": {
        "type": "git",
        "url": "https://github.com/joeclack/EarsMixer.git"
    },
    "scripts": {
        "start": "node index.js",
        "dev": "node tools/dev.cjs",
        "test": "node --test \"test/**/*.test.js\"",
        "mock-desk": "node tools/mock-desk.js",
        "build:js": "esbuild web/mixer.js --minify --outfile=web/mixer.min.js",
        "build:css": "esbuild web/mixer.css --minify --outfile=web/mixer.min.css",
        "build": "npm run build:js && npm run build:css",
        "prepackage": "npm run build",
        "package": "npx pkg . --output \"dist/EarsMixer-${npm_package_version}\"",
        "installer:windows": "node tools/build-installer.cjs",
        "build:windows-support": "node tools/build-windows-support.cjs",
        "package-plugins": "zip -r dist/EarsMixer-plugins-${npm_package_version}.zip plugins/"
    },
    "license": "MIT",
    "keywords": [
        "Open Sound Control",
        "OSC",
        "sound",
        "audio",
        "DiGiCo"
    ],
    "devDependencies": {
        "@yao-pkg/pkg": "^6.22.0",
        "esbuild": "0.28.2"
    },
    "dependencies": {
        "colortranslator": "^6.1.1",
        "express": "^4.22.1",
        "ora": "^5.4.1",
        "osc": "github:castles/osc.js",
        "qrcode": "^1.5.4",
        "ws": "8.21.3"
    },
    "pkg": {
        "scripts": [
            "lib/**/*.js",
            "index.js"
        ],
        "assets": [
            "installer/version.inc.iss",
            "web/**/*"
        ],
        "ignore": [
            "config.json"
        ],
        "targets": [
            "node22-linux-x64",
            "node22-macos-x64",
            "node22-macos-arm64",
            "node22-win-x64"
        ],
        "outputPath": "dist"
    },
    "bin": {
        "earsmixer": "index.js"
    }
}
